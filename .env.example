# ============================================================
# meta-order-attribution — متغيرات البيئة (مثال بدون أسرار)
# انسخ هذا الملف إلى .env في نفس المجلد واملأ القيم الفعلية.
# لا تضع أي Access Token أو App Secret هنا في هذا الملف (.example).
# ============================================================

# ---- عام ----
NODE_ENV=development
PORT=4000
TZ=Asia/Baghdad
APP_TIMEZONE=Asia/Baghdad
DEFAULT_CURRENCY=IQD
PUBLIC_BASE_URL=http://localhost:4000
# عنوان لوحة تحكم الـWorkspace (Next.js) - لإعادة توجيه المتصفح إليها بعد اكتمال Meta OAuth
WEB_PUBLIC_BASE_URL=http://localhost:3000

# ---- المزامنة التلقائية ----
AUTO_SYNC_ENABLED=true
# 5-field cron بتوقيت APP_TIMEZONE. الافتراضي: كل ساعة عند الدقيقة صفر
AUTO_SYNC_CRON=0 * * * *
# نافذة "آخر 24 ساعة" في /api/dashboard/last-24-hours - قابلة للتعديل بالساعات
ROLLING_WINDOW_HOURS=24

# ---- Anthropic (محجوز لمرحلة مستقبلية: تحليل محادثات) ----
# غير مُستخدم حاليًا في الكود — يتطلب أولًا صلاحيتي Meta pages_messaging و
# instagram_manage_messages عبر App Review منفصل. راجع DECISIONS.md وMETA_APP_REVIEW.md.
ANTHROPIC_API_KEY=

# ---- قاعدة البيانات ----
# منذ نسخة Multi-Tenant، القاعدة الأساسية أصبحت PostgreSQL (وليس SQLite) — راجع DECISIONS.md.
# محليًا عبر docker-compose (docker-compose up -d postgres) أو قاعدة سحابية مجانية مؤقتة
# للتطوير (مثل Neon/Supabase) إن لم يكن Docker مثبّتًا على الجهاز:
DATABASE_URL="postgresql://meta_attribution:changeme_local_only@localhost:5432/meta_order_attribution?schema=public"

# مسار قاعدة SQLite القديمة (نظام أحادي المستأجر السابق) — يُستخدم فقط مرة واحدة من
# سكربت `npm run migrate:sqlite-to-postgres --workspace=server` لنقل بياناتك الحقيقية
# (Leads/Insights/...) إلى أول Workspace في Postgres. لا علاقة له بتشغيل الخادم العادي.
LEGACY_SQLITE_DATABASE_URL="file:./prisma/prisma/dev.db"

# مفتاح تشفير توكنات Meta المخزّنة في MetaConnection (AES-256-GCM) — يجب أن يكون 32 بايت.
# ولّده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# الـWorkspace الذي يستمر خط Webhook/Insights/Sheets القديم بالكتابة إليه بعد الانتقال لـ
# Postgres. يُملأ بمعرّف الـWorkspace الناتج من: npm run seed:workspace --workspace=server
LEGACY_WORKSPACE_ID=

# ---- Meta App (Meta for Developers) ----
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
# رمز التحقق الذي تختاره أنت بنفسك عند إعداد Webhook في لوحة تحكم Meta
META_WEBHOOK_VERIFY_TOKEN=
# System User Access Token أو Page Access Token طويل الأمد (سر - لا يُرفع لأي مكان)
META_PAGE_ACCESS_TOKEN=
# معرفات غير سرية — تم اكتشافها عبر MCP لمشروع "نضارة (طنين الاذن)"
META_BUSINESS_ID=762472333565499
META_PAGE_ID=1126970097176252
META_AD_ACCOUNT_ID=1708235990232230
# Dataset ID الخاص بـ Conversions API for CRM / Conversion Leads (يُعبأ لاحقًا إن توفر)
META_CONVERSIONS_DATASET_ID=
# حساب Instagram المرتبط (اختياري، لم يُستخدم في الكود حاليًا - محجوز لمرحلة رسائل Instagram المستقبلية)
META_INSTAGRAM_ACCOUNT_ID=
# ملاحظة: META_WEBHOOK_VERIFY_TOKEN وMETA_PAGE_ACCESS_TOKEN أعلاه يغطيان نفس دور
# META_VERIFY_TOKEN / META_ACCESS_TOKEN المذكورين أحيانًا في وثائق أخرى — نفس القيمة، اسم مختلف فقط.

# ---- Meta App Secret لخدمة الويب (web/) - Deauthorize + Data Deletion Callbacks ----
# نفس القيمة الحقيقية لـMETA_APP_SECRET أعلاه بالضبط (نفس تطبيق Meta) - متغيّر منفصل لأن
# /facebook/deauthorize و/facebook/data-deletion يعملان داخل خدمة web وليس server. يُضبط في
# إعدادات بيئة خدمة web على Render، وليس هنا.
FACEBOOK_APP_SECRET=

# ---- لوحة التحكم / Auth ----
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# سرّ JWT منفصل تمامًا لجلسات Super Admin (لا يجب أن يتقاطع مع جلسات مستخدمي الـWorkspaces)
SUPERADMIN_JWT_SECRET=

# ---- Google Sheets (اختياري) ----
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# ضع مفتاح Service Account في ملف منفصل خارج git، وأشر لمساره هنا
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json

# ---- الويب (لوحة التحكم Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
